# Create React App: copiar a .env.local si se desea configurar explícitamente.
# El frontend local y el desplegado utilizan el mismo backend en Render.
PORT=3001
REACT_APP_API_URL=https://cubica-photo-app.onrender.com
API_PROXY_TARGET=https://cubica-photo-app.onrender.com

# Milisegundos. 0 desactiva el timeout de esa operación.
REACT_APP_REQUEST_TIMEOUT_MS=30000
REACT_APP_UPLOAD_TIMEOUT_MS=180000
REACT_APP_PDF_TIMEOUT_MS=600000

# Producción: definir REACT_APP_API_URL=https://cubica-photo-app.onrender.com
# ANTES de npm run build. Cambiarla requiere reconstruir y publicar build/.
# Sin REACT_APP_API_URL también se utiliza Render, tanto en local como en producción.
# API_PROXY_TARGET solo sirve para npm start; no se incluye en el build.
# No colocar claves ni credenciales R2 en variables REACT_APP_*.
